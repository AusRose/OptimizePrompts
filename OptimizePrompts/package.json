{
  "name": "dsh-optimize-prompts",
  "version": "1.1.0",
  "private": true,
  "description": "Rewrite the current composer draft into a clearer prompt with a configured DeepSeek Harness model, images included, and append validated file/skill references without sending it.",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "src",
    "build.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "PROJECT.md"
  ],
  "scripts": {
    "build": "node build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT"
}
